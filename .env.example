# Resource Allocator Environment Configuration

# Database Connection
# Format: postgres://user:password@localhost:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atropos

# Logging level (debug, info, warn, error)
RUST_LOG=info

# API authentication (optional).
# When set, all mutating REST endpoints and the gRPC AllocationService require
# an `Authorization: Bearer <token>` header/metadata. Leave unset for local dev
# (endpoints are unauthenticated and a startup warning is logged).
# ATROPOS_API_TOKEN=change-me

# Webhook signing secret (optional).
# When set, outbound webhook deliveries (lease granted/revoked events) are
# signed with an HMAC-SHA256 hex digest in the `X-Atropos-Signature` header so
# receivers can verify authenticity. Leave unset to send unsigned payloads.
# ATROPOS_WEBHOOK_SECRET=change-me

